<?xml version="1.0" encoding="utf-8"?>
<!-- Tripometer home screen widget. Texts and clicks are set by SpeedTrackerWidget.refresh(). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/speedtracker_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/speedtracker_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tripometer"
            android:textColor="#A1A1AA"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/speedtracker_widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not recording"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/speedtracker_widget_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <Button
        android:id="@+id/speedtracker_widget_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="88dp"
        android:text="Start"
        android:textAllCaps="false" />
</LinearLayout>
