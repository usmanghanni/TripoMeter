{
    "namespace": "SpeedTracker",
    "bridge_functions": [
        {
            "name": "Geolocation.WatchPosition",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.WatchPosition",
            "ios": "SpeedTrackerFunctions.WatchPosition",
            "description": "Start a foreground GPS watch for live speed (no notification, stops with the screen)"
        },
        {
            "name": "Geolocation.StartBackgroundWatch",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.StartBackgroundWatch",
            "ios": "SpeedTrackerFunctions.StartBackgroundWatch",
            "description": "Start a GPS watch that keeps running while the app is backgrounded"
        },
        {
            "name": "Geolocation.StopBackgroundWatch",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.StopBackgroundWatch",
            "ios": "SpeedTrackerFunctions.StopBackgroundWatch",
            "description": "Stop the GPS watch"
        },
        {
            "name": "Geolocation.ClearWatch",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.ClearWatch",
            "ios": "SpeedTrackerFunctions.ClearWatch",
            "description": "Stop a foreground (screen-only) GPS watch"
        },
        {
            "name": "Geolocation.DrainWatchBuffer",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.DrainWatchBuffer",
            "ios": "SpeedTrackerFunctions.DrainWatchBuffer",
            "description": "Return buffered fixes after a cursor"
        },
        {
            "name": "Geolocation.TrimWatchBuffer",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.TrimWatchBuffer",
            "ios": "SpeedTrackerFunctions.TrimWatchBuffer",
            "description": "Drop buffered fixes up to a cursor"
        },
        {
            "name": "SpeedTracker.PlayAlert",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.PlayAlert",
            "ios": "SpeedTrackerFunctions.PlayAlert",
            "description": "Play a short alert beep"
        },
        {
            "name": "SpeedTracker.KeepScreenOn",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.KeepScreenOn",
            "ios": "SpeedTrackerFunctions.KeepScreenOn",
            "description": "Keep the screen awake while the app is in the foreground"
        },
        {
            "name": "SpeedTracker.SetUnit",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFunctions.SetUnit",
            "ios": "SpeedTrackerFunctions.SetUnit",
            "description": "Set km/h or mph for the trip notification"
        },
        {
            "name": "SpeedTracker.NowPlaying",
            "android": "com.app.plugins.speedtracker.SpeedTrackerMediaFunctions.NowPlaying",
            "ios": "SpeedTrackerFunctions.NowPlaying",
            "description": "Title, artist and state of the music playing in any app"
        },
        {
            "name": "SpeedTracker.MediaCommand",
            "android": "com.app.plugins.speedtracker.SpeedTrackerMediaFunctions.MediaCommand",
            "ios": "SpeedTrackerFunctions.MediaCommand",
            "description": "Play, pause, next or previous on the active music app"
        },
        {
            "name": "SpeedTracker.OpenMediaAccessSettings",
            "android": "com.app.plugins.speedtracker.SpeedTrackerMediaFunctions.OpenMediaAccessSettings",
            "ios": "SpeedTrackerFunctions.OpenMediaAccessSettings",
            "description": "Open the system screen that grants media (notification listener) access"
        },
        {
            "name": "SpeedTracker.AdjustVolume",
            "android": "com.app.plugins.speedtracker.SpeedTrackerMediaFunctions.AdjustVolume",
            "ios": "SpeedTrackerFunctions.AdjustVolume",
            "description": "Step the music volume up or down"
        },
        {
            "name": "SpeedTracker.Notify",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFileFunctions.Notify",
            "ios": "SpeedTrackerFileFunctions.Notify",
            "description": "Post a local notification"
        },
        {
            "name": "SpeedTracker.SaveFile",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFileFunctions.SaveFile",
            "ios": "SpeedTrackerFileFunctions.SaveFile",
            "description": "Save a copy of an app file wherever the user chooses (fires FileSaved)"
        },
        {
            "name": "SpeedTracker.PickFile",
            "android": "com.app.plugins.speedtracker.SpeedTrackerFileFunctions.PickFile",
            "ios": "SpeedTrackerFileFunctions.PickFile",
            "description": "Let the user choose a file to open (fires FilePicked)"
        }
    ],
    "android": {
        "min_version": 26,
        "permissions": [
            "android.permission.ACCESS_FINE_LOCATION",
            "android.permission.ACCESS_COARSE_LOCATION",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_LOCATION",
            "android.permission.POST_NOTIFICATIONS"
        ],
        "services": [
            {
                "name": "com.app.plugins.speedtracker.SpeedTrackerService",
                "exported": false,
                "foregroundServiceType": "location"
            },
            {
                "name": "com.app.plugins.speedtracker.SpeedTrackerMediaListener",
                "exported": true,
                "permission": "android.permission.BIND_NOTIFICATION_LISTENER_SERVICE",
                "intent_filters": [
                    {
                        "action": "android.service.notification.NotificationListenerService"
                    }
                ]
            }
        ]
    },
    "ios": {
        "min_version": "18.2",
        "info_plist": {
            "NSLocationWhenInUseUsageDescription": "Your location is used to measure speed and record trips."
        },
        "background_modes": [
            "location"
        ]
    },
    "events": [
        "App\\SpeedTracker\\Events\\FileSaved",
        "App\\SpeedTracker\\Events\\FilePicked"
    ]
}
