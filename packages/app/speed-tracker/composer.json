{
    "name": "app/speed-tracker",
    "description": "Free native backend for the core Geolocation facade: GPS speed watch with Android foreground service and iOS background location.",
    "type": "nativephp-plugin",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\SpeedTracker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "App\\SpeedTracker\\SpeedTrackerServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
